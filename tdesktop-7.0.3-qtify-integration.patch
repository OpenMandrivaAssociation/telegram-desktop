-				dataRequest(
-					std::move(resolved),
-					socket,
-					resourceId,
-					requestedOffset,
-					requestedLimit,
-					false,
-					guard);
-			});
-			_dataRequestHandler(prepared);
-		});
-
-	if (!_dataServer->listen(QHostAddress::LocalHost)) {
-		LOG(("WebView Error: %1").arg(_dataServer->errorString()));
-		_dataServer.reset();
-		return false;
-	}
-
-	_dataPort = _dataServer->serverPort();
