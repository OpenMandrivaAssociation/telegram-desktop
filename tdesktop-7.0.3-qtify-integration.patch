-void Instance::scheduleQueuedEvals() {
-	if (_queuedScriptDialogEvals.empty()) {
-		return;
-	}
-	struct QueuedEvals {
-		::base::weak_ptr<Instance> instance;
-		std::vector<std::string> scripts;
-	};
