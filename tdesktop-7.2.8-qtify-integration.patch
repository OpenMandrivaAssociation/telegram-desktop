+void Manager::Private::clearNotificationByDBusId(uint id) {
+	for (auto ctxIt = _notifications.begin(); ctxIt != _notifications.end(); ) {
+		auto &map = ctxIt->second;
+		for (auto idIt = map.begin(); idIt != map.end(); ) {
+			if (idIt->second == id) {
+				idIt = map.erase(idIt);
+			} else {
+				++idIt;
+			}
+		}
+		if (map.empty()) {
+			ctxIt = _notifications.erase(ctxIt);
+		} else {
+			++ctxIt;
+		}
+	}
+}
