+class Handler final : public QWebEngineUrlSchemeHandler {
+public:
+	explicit Handler(Fn<DataResult(DataRequest)> handler);
+
+	void requestStarted(QWebEngineUrlRequestJob *job) override;
+
+private:
+	const Fn<DataResult(DataRequest)> _handler;
+};
+
+Handler::Handler(Fn<DataResult(DataRequest)> handler)
+: _handler(std::move(handler)) {
+}
+
+void Handler::requestStarted(QWebEngineUrlRequestJob *job) {
+	if (!_handler) {
+		job->fail(QWebEngineUrlRequestJob::UrlInvalid);
+		return;
+	}
+
+	const auto guard = QPointer<QWebEngineUrlRequestJob>(job);
+	const auto finish = [guard](DataResponse response, std::int64_t offset, std::int64_t limit) {
+		crl::on_main([guard, response = std::move(response), offset, limit]() mutable {
+			const auto job = guard.data();
+			if (!job) {
+				return;
+			}
+			if (!response.stream) {
+				job->fail(QWebEngineUrlRequestJob::RequestFailed);
+				return;
+			}
+			auto &stream = *response.stream;
+			const auto mime = QByteArray::fromStdString(stream.mime());
+			if (offset > 0) {
+				stream.seek(SEEK_SET, offset);
+			}
+			const auto maxBytes = (limit > 0)
+				? limit
+				: std::max<std::int64_t>(stream.size() - std::max<std::int64_t>(offset, 0), 0);
+			// Cap individual reply to 64 MiB to avoid runaway allocations.
+			const auto want = std::min<std::int64_t>(
+				maxBytes > 0 ? maxBytes : stream.size(),
+				64 * 1024 * 1024);
+			QByteArray body;
+			if (want > 0) {
+				body.resize(int(want));
+				auto filled = std::int64_t(0);
+				while (filled < want) {
+					const auto got = stream.read(body.data() + filled, want - filled);
+					if (got <= 0) {
+						break;
+					}
+					filled += got;
+				}
+				body.resize(int(filled));
+			} else {
+				// Unknown size: read in chunks.
+				QByteArray chunk(64 * 1024, Qt::Uninitialized);
+				while (true) {
+					const auto got = stream.read(chunk.data(), chunk.size());
+					if (got <= 0) {
+						break;
+					}
+					body.append(chunk.constData(), int(got));
+					if (body.size() >= 64 * 1024 * 1024) {
+						break;
+					}
+				}
+			}
+			auto *buffer = new QBuffer(job);
+			buffer->setData(body);
+			buffer->open(QIODevice::ReadOnly);
+			job->reply(mime, buffer);
+		});
+	};
+
+	std::int64_t offset = 0;
+	std::int64_t limit = -1;
+	auto request = DataRequest{
+		.id = job->requestUrl().path().mid(1).toStdString(),
+		.offset = 0,
+		.limit = -1,
+	};
+	const auto range = job->requestHeaders().value("Range");
+	if (!range.isEmpty()) {
+		ParseRangeHeaderFor(request, range.toStdString());
+	}
+	offset = request.offset;
+	limit = request.limit;
+	request.done = [finish, offset, limit](DataResponse response) {
+		finish(std::move(response), offset, limit);
+	};
+
+	const auto result = _handler(std::move(request));
+	if (result == DataResult::Failed) {
+		job->fail(QWebEngineUrlRequestJob::RequestFailed);
+	}
+	// DataResult::Done: handler already invoked request.done synchronously.
+	// DataResult::Pending: request.done will be invoked later.
+}
+
+class MessageHandler final : public QWebEngineUrlSchemeHandler {
+public:
+	explicit MessageHandler(Fn<void(std::string, std::string)> handler)
+	: _handler(std::move(handler)) {
+	}
+
+	void requestStarted(QWebEngineUrlRequestJob *job) override {
+		if (!_handler) {
+			job->fail(QWebEngineUrlRequestJob::UrlInvalid);
+			return;
+		}
+		const auto url = job->requestUrl();
+		auto source = QUrlQuery(url).queryItemValue(
+			u"src"_q,
+			QUrl::FullyDecoded).toStdString();
+		QByteArray body;
+		if (job->requestMethod() == "POST") {
+			body = ReadDevice(job->requestBody(), kMaxMessageBytes);
+		} else {
+			body = QUrlQuery(url).queryItemValue(
+				u"data"_q,
+				QUrl::FullyDecoded).toUtf8();
+		}
+		if (body.size() > kMaxMessageBytes) {
+			body.resize(kMaxMessageBytes);
+		}
+		if (_handler) {
+			_handler(std::string(body.constData(), body.size()), std::move(source));
+		}
+		auto *buffer = new QBuffer(job);
+		buffer->setData(QByteArray());
+		buffer->open(QIODevice::ReadOnly);
+		job->reply("text/plain", buffer);
+	}
+
+private:
+	const Fn<void(std::string, std::string)> _handler;
+};
