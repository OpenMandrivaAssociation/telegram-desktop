+void QtWebEngineInterface::setupProfile(const Config &config) {
+	if (!config.restrictedOrigin.empty()) {
+		_profile = new QWebEngineProfile(_view.get());
+		_ownsProfile = true;
+		_profile->setPersistentCookiesPolicy(
+			QWebEngineProfile::NoPersistentCookies);
+		_profile->setHttpCacheType(QWebEngineProfile::MemoryHttpCache);
+		if (auto *store = _profile->cookieStore()) {
+			store->setCookieFilter([](const QWebEngineCookieStore::FilterRequest &) {
+				return false;
+			});
+		}
+		return;
+	}
+	const auto path = !config.userDataPath.empty()
+		? QString::fromStdString(config.userDataPath)
+		: StoragePath(config.userDataToken);
+	if (!path.isEmpty()) {
+		_profile = new QWebEngineProfile(
+			QString::fromStdString(
+				config.userDataToken.empty() ? "webview" : config.userDataToken),
+			_view.get());
+		_profile->setPersistentStoragePath(path);
+		_profile->setCachePath(path + u"/cache"_q);
+		_profile->setPersistentCookiesPolicy(
+			QWebEngineProfile::AllowPersistentCookies);
+		_profile->setHttpCacheType(QWebEngineProfile::DiskHttpCache);
+		_ownsProfile = true;
+		if (config.allowThirdPartyCookies) {
+			if (auto *store = _profile->cookieStore()) {
+				store->setCookieFilter([](const QWebEngineCookieStore::FilterRequest &) {
+					return true;
+				});
+			}
+		}
+		return;
+	}
+	_profile = QWebEngineProfile::defaultProfile();
+	_ownsProfile = false;
+	if (config.allowThirdPartyCookies) {
+		if (auto *store = _profile->cookieStore()) {
+			store->setCookieFilter([](const QWebEngineCookieStore::FilterRequest &) {
+				return true;
+			});
+		}
+	}
+}
+
+void QtWebEngineInterface::connectViewSignals() {
+	QObject::connect(
+		_page,
+		&QWebEnginePage::loadFinished,
+		_view.get(),
+		[=](bool ok) {
+			if (_config.navigationDoneHandler) {
+				_config.navigationDoneHandler(ok);
+			}
+			refreshNavigationHistoryState();
+		});
+	QObject::connect(
+		_page,
+		&QWebEnginePage::fullScreenRequested,
+		_view.get(),
+		[=](QWebEngineFullScreenRequest request) {
+			if (!_config.restrictedOrigin.empty()) {
+				request.reject();
+				return;
+			}
+			request.accept();
+			if (_view) {
+				if (request.toggleOn()) {
+					_view->showFullScreen();
+				} else {
+					_view->showNormal();
+				}
+			}
+		});
+	QObject::connect(
+		_page,
+		&QWebEnginePage::titleChanged,
+		_view.get(),
+		[=](const QString &) { refreshNavigationHistoryState(); });
+	QObject::connect(
+		_page,
+		&QWebEnginePage::urlChanged,
+		_view.get(),
+		[=](const QUrl &) { refreshNavigationHistoryState(); });
+}
