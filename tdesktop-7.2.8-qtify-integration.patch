+void QtWebEngineInterface::setFullscreen(bool fullscreen) {
+	if (!_view || _config.mode == WindowMode::Hidden) {
+		return;
+	}
+	if (fullscreen) {
+		_view->showFullScreen();
+	} else {
+		_view->showNormal();
+	}
+}
