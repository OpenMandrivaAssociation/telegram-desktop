+
+void QtWebEngineInterface::navigateToData(std::string id) {
+	const auto override = QString::fromStdString(_config.dataProtocolOverride);
+	const auto base = override.isEmpty()
+		? (QString(kDataScheme) + u"://"_q)
+		: override;
+	_view->load(QUrl(base + QString::fromStdString(id)));
+}
