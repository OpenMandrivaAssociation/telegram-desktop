+bool Page::acceptNavigationRequest(
+		const QUrl &url,
+		NavigationType type,
+		bool isMainFrame) {
+	if (_interactionHandler) {
+		_interactionHandler();
+	}
+	const auto scheme = url.scheme();
+	if (scheme == kMessageScheme) {
+		if (_messageHandler && url.path().startsWith(kMessagePath)) {
+			auto data = QUrlQuery(url).queryItemValue(
+				u"data"_q,
+				QUrl::FullyDecoded).toStdString();
+			auto source = QUrlQuery(url).queryItemValue(
+				u"src"_q,
+				QUrl::FullyDecoded).toStdString();
+			if (source.empty()) {
+				source = this->url().toString().toStdString();
+			}
+			_messageHandler(std::move(data), std::move(source));
+		}
+		return false;
+	}
+	if (!_restrictedOrigin.empty()
+		&& scheme != kDataScheme
+		&& !AllowedRestrictedUrl(url, _restrictedOrigin)) {
+		return false;
+	}
+	if (_navStartHandler) {
+		const auto external = (type == NavigationTypeRedirect);
+		if (!_navStartHandler(url.toString().toStdString(), external)) {
+			return false;
+		}
+	}
+	return QWebEnginePage::acceptNavigationRequest(url, type, isMainFrame);
+}
