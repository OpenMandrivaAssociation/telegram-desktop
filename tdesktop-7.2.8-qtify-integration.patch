+	: _process(std::move(process)) {
+		qApp->installEventFilter(this);
+	}
+
+	~WaylandKeyFilter() override {
+		if (qApp) {
+			qApp->removeEventFilter(this);
+		}
+	}
+
+protected:
+	bool eventFilter(QObject *watched, QEvent *event) override {
+		Q_UNUSED(watched);
+		if (!_process) {
+			return false;
+		}
+		const auto type = event->type();
+		if (type != QEvent::KeyPress && type != QEvent::KeyRelease) {
+			return false;
+		}
+		// Only treat as global-shortcut candidates when no text widget is
+		// actively consuming input; still useful for shortcut recording UIs
+		// and for Plasma when the main window is focused.
+		const auto *keyEvent = static_cast<QKeyEvent*>(event);
+		if (keyEvent->isAutoRepeat()) {
+			return false;
+		}
+		const auto key = keyEvent->key();
+		if (key == Qt::Key_unknown
+			|| key == Qt::Key_Shift
+			|| key == Qt::Key_Control
+			|| key == Qt::Key_Alt
+			|| key == Qt::Key_Meta
+			|| key == Qt::Key_AltGr) {
+			// Skip pure modifiers; the combo key carries modifiers in native.
+			return false;
+		}
+		// Map Qt key to a stable descriptor: store Qt::Key in the low 32 bits.
+		// KeyName() already knows how to pretty-print many xkb keysyms; for Qt
+		// keys we fall through to a hex display which is fine for matching.
+		const auto descriptor = GlobalShortcutKeyGeneric(uint64(key));
+		_process(descriptor, type == QEvent::KeyPress);
+		return false;
+	}
