+
+void QtWebEngineInterface::refreshNavigationHistoryState() {
+	if (!_page) {
+		return;
+	}
+	auto *h = _page->history();
+	const auto canBack = h && h->canGoBack();
+	const auto canForward = h && h->canGoForward();
+	const auto current = h
+		? h->currentItem().url().toString().toStdString()
+		: std::string();
+	const auto title = _page->title().toStdString();
+	_navHistory.fire({
+		.url = std::move(current),
+		.title = title,
+		.canGoBack = canBack,
+		.canGoForward = canForward,
+	});
+}
+
+auto QtWebEngineInterface::navigationHistoryState()
+-> rpl::producer<NavigationHistoryState> {
+	return _navHistory.events();
+}
