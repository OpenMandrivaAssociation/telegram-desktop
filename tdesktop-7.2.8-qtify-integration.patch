+
+void QtWebEngineInterface::addUserScript(std::string js, bool allFrames) {
+	auto script = QWebEngineScript();
+	script.setSourceCode(QString::fromStdString(js));
+	script.setInjectionPoint(QWebEngineScript::DocumentCreation);
+	script.setWorldId(QWebEngineScript::MainWorld);
+	script.setRunsOnSubFrames(allFrames);
+	_page->scripts().insert(script);
+}
+
+void QtWebEngineInterface::init(std::string js) {
+	addUserScript(js, false);
+	eval(std::move(js));
+}
+
+void QtWebEngineInterface::initAllFrames(std::string js) {
+	addUserScript(std::move(js), true);
+}
+
+void QtWebEngineInterface::eval(std::string js) {
+	_page->runJavaScript(QString::fromStdString(js));
+}
