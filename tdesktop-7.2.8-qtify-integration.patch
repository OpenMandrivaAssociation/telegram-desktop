+void Manager::Private::ensureInterface() {
+	if (_interface && _interface->isValid()) {
+		return;
+	}
+	_interface = std::make_unique<QDBusInterface>(
+		QString::fromLatin1(kService),
+		QString::fromLatin1(kObjectPath),
+		QString::fromLatin1(kInterface),
+		QDBusConnection::sessionBus());
+}
+
+void Manager::Private::connectSignals() {
+	auto bus = QDBusConnection::sessionBus();
+	const auto service = QString::fromLatin1(kService);
+	const auto path = QString::fromLatin1(kObjectPath);
+	const auto iface = QString::fromLatin1(kInterface);
+
+	// Drop previous match rules before re-subscribing (service restart).
+	bus.disconnect(
+		service,
+		path,
+		iface,
+		u"ActionInvoked"_q,
+		this,
+		SLOT(onActionInvoked(uint,QString)));
+	bus.disconnect(
+		service,
+		path,
+		iface,
+		u"NotificationClosed"_q,
+		this,
+		SLOT(onNotificationClosed(uint,uint)));
+
+	// Requires Q_OBJECT on this class so the meta-object has the slots.
+	if (!bus.connect(
+			service,
+			path,
+			iface,
+			u"ActionInvoked"_q,
+			this,
+			SLOT(onActionInvoked(uint,QString)))) {
+		LOG(("Native Notification Error: failed to connect ActionInvoked: %1"
+			).arg(bus.lastError().message()));
+	}
+	if (!bus.connect(
+			service,
+			path,
+			iface,
+			u"NotificationClosed"_q,
+			this,
+			SLOT(onNotificationClosed(uint,uint)))) {
+		LOG(("Native Notification Error: failed to connect NotificationClosed: %1"
+			).arg(bus.lastError().message()));
 	}
 }
 
